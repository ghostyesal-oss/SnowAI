{
  "manifest_version": 3,
  "name": "Snow AI",
  "short_name": "Snow AI",
  "version": "1.2.0",
  "description": "Panneau latéral : lit le hub (tickets fictifs) et affiche la résolution IA.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://*.supabase.co/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Ouvrir Snow AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
